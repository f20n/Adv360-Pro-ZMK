#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                            &mo 7      &kp N6  &kp N7    &kp N8        &kp N9    &kp N0           &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 1                                                           &none      &kp Y   &kp U     &kp I         &kp O     &kp P            &kp BSLH
&kp ESC    &lt 3 A    &kp S     &lt 4 D   &kp F      &kp G   &none     &kp LCTRL  &kp LEFT_GUI      &kp LEFT_ALT   &kp RCTRL  &none      &kp H   &kp J     &lt 5 K       &kp L     &lt 2 SEMICOLON  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME          &kp LA(SPACE)                        &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH         &kp LEFT_SHIFT
&mo 6      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END           &kp LG(SPACE)  &kp ENTER  &kp SPACE          &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT         &mo 6
            >;
        };

        gaming {
            display-name = "Gaming";
            bindings = <
&kp PAGE_UP    &kp N1          &kp N2  &kp N3  &kp N4  &kp N5  &none                                                        &mo 7      &kp N6  &kp N7    &kp N8        &kp N9    &kp N0    &kp MINUS
&kp PAGE_DOWN  &kp Y           &kp Q   &kp W   &kp E   &kp R   &trans                                                       &none      &kp Y   &kp U     &kp I         &kp O     &kp P     &kp BSLH
&kp ESCAPE     &kp LEFT_SHIFT  &kp A   &kp S   &kp D   &kp F   &none      &kp G    &kp ENTER      &kp LEFT_ALT   &kp RCTRL  &none      &kp H   &kp J     &kp K         &kp L     &kp SEMI  &kp SQT
&none          &kp LCTRL       &kp Z   &kp X   &kp C   &kp V                       &kp M          &kp LA(SPACE)                        &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH  &kp LEFT_SHIFT
&mo 6          &kp LEFT_ALT    &none   &kp N   &kp T           &kp SPACE  &kp TAB  &kp B          &kp LG(SPACE)  &kp ENTER  &kp SPACE          &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT  &mo 6
            >;
        };

        brackets_right {
            display-name = "br";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                            &mo 7      &kp N6  &kp N7                 &kp N8            &kp N9             &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 1                                                           &none      &kp Y   &kp U                  &kp GREATER_THAN  &kp O              &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LEFT_GUI      &kp LEFT_ALT   &kp RCTRL  &none      &kp H   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE   &kp RIGHT_BRACKET  &trans    &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME          &kp LA(SPACE)                        &kp N   &kp M                  &kp COMMA         &kp DOT            &kp FSLH  &kp LEFT_SHIFT
&mo 6      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END           &kp LG(SPACE)  &kp ENTER  &kp SPACE          &kp DOWN               &kp UP_ARROW      &kp LBKT           &kp RBKT  &mo 6
            >;
        };

        brackets_left {
            display-name = "bl";
            bindings = <
&kp EQUAL  &kp N1     &kp N2            &kp N3          &kp N4                &kp N5  &none                                                            &mo 7      &kp N6  &kp N7    &kp N8        &kp N9    &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W             &kp LESS_THAN   &kp R                 &kp T   &tog 1                                                           &none      &kp Y   &kp U     &kp I         &kp O     &kp P          &kp BSLH
&kp ESC    &trans     &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp G   &none     &kp LCTRL  &kp LEFT_GUI      &kp LEFT_ALT   &kp RCTRL  &none      &kp H   &kp J     &kp K         &kp L     &kp SEMICOLON  &kp SQT
&kp LSHFT  &kp Z      &kp X             &kp C           &kp V                 &kp B                        &kp HOME          &kp LA(SPACE)                        &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH       &kp LEFT_SHIFT
&mo 6      &kp GRAVE  &kp CAPS          &kp LEFT        &kp RIGHT                     &kp BSPC  &kp DEL    &kp END           &kp LG(SPACE)  &kp ENTER  &kp SPACE          &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT       &mo 6
            >;
        };

        super_right {
            display-name = "sr";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                            &mo 7      &kp LS(LA(LC(LG(N6))))  &kp LS(LA(LC(LG(N7))))  &kp LG(LC(LS(LA(N8))))     &kp LS(LA(LC(LG(N9))))   &kp LS(LA(LC(LG(N0))))    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 1                                                           &none      &kp LS(LG(LC(LA(Y))))   &kp LS(LA(LC(LG(U))))   &kp LS(LA(LC(LG(I))))      &kp LS(LA(LC(LG(O))))    &kp LC(LG(LA(LS(P))))     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &trans     &kp G   &none     &kp LCTRL  &kp LEFT_GUI      &kp LEFT_ALT   &kp RCTRL  &none      &kp LS(LA(LC(LG(H))))   &kp LS(LA(LC(LG(J))))   &kp LS(LC(LG(LA(K))))      &kp LS(LA(LC(LG(L))))    &kp LA(LC(LG(LS(SEMI))))  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME          &kp LA(SPACE)                        &kp LS(LA(LC(LG(N))))   &kp LS(LA(LC(LG(M))))   &kp LS(LA(LC(LG(COMMA))))  &kp LS(LA(LC(LG(DOT))))  &kp LS(LA(LC(LG(FSLH))))  &kp LEFT_SHIFT
&mo 6      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END           &kp LG(SPACE)  &kp ENTER  &kp SPACE                          &kp DOWN                &kp UP_ARROW               &kp LBKT                 &kp RBKT                  &mo 6
            >;
        };

        super_left {
            display-name = "sl";
            bindings = <
&kp EQUAL  &kp LC(LG(LA(LS(N1))))  &kp LA(LC(LG(LS(N2))))  &kp LA(LC(LG(LS(N3))))  &kp LS(LA(LG(LC(N4))))  &kp LS(LA(LC(LG(N5))))  &none                                                            &mo 7      &kp N6  &kp N7    &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp LS(LA(LC(LG(Q))))   &kp LS(LC(LA(LG(W))))   &kp LS(LA(LC(LG(E))))   &kp LS(LC(LG(LA(R))))   &kp LS(LA(LC(LG(T))))   &tog 1                                                           &none      &kp Y   &kp U     &kp I         &kp O     &kp P     &kp BSLH
&kp ESC    &kp LS(LA(LC(LG(A))))   &kp LA(LS(LC(LG(S))))   &kp LS(LG(LC(LA(D))))   &kp LS(LA(LC(LG(F))))   &kp LS(LA(LC(LG(G))))   &none     &kp LCTRL  &kp LEFT_GUI      &kp LEFT_ALT   &kp RCTRL  &none      &kp H   &kp J     &trans        &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp LS(LA(LC(LG(Z))))   &kp LS(LA(LC(LG(X))))   &kp LS(LA(LC(LG(C))))   &kp LS(LA(LC(LG(V))))   &kp LS(LA(LC(LG(B))))                        &kp HOME          &kp LA(SPACE)                        &kp N   &kp M     &kp COMMA     &kp DOT   &kp FSLH  &kp LEFT_SHIFT
&mo 6      &kp GRAVE               &kp CAPS                &kp LEFT                &kp RIGHT                                       &kp BSPC  &kp DEL    &kp END           &kp LG(SPACE)  &kp ENTER  &kp SPACE          &kp DOWN  &kp UP_ARROW  &kp LBKT  &kp RBKT  &mo 6
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none                                       &mo 7   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &tog 1                                      &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_DEC  &bl BL_INC  &none  &none  &none
            >;
        };
    };
};
